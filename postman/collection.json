{
  "info": {
    "name": "API Testing Framework Reference",
    "_postman_id": "b1f8c3a2-0000-4000-8000-0000000000a1",
    "description": "Smoke + happy path collection for the reference API. Covers health, authentication, users CRUD, and basic order operations. Runs in order (login captures token, creation captures the id used by the following operations).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('body indicates status up', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('payload contains token and user', function () {",
                  "  pm.expect(body).to.have.property('token').that.is.a('string').and.has.length.greaterThan(20);",
                  "  pm.expect(body).to.have.property('user');",
                  "  pm.expect(body.user.role).to.eql('admin');",
                  "});",
                  "",
                  "pm.test('captures token in the environment', function () {",
                  "  pm.environment.set('token', body.token);",
                  "  pm.expect(pm.environment.get('token')).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('returned user is the admin', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.email).to.eql(pm.environment.get('adminEmail'));",
                  "  pm.expect(body.role).to.eql('admin');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /users?perPage=5",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?perPage=5",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [{ "key": "perPage", "value": "5" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('data is an array with at most 5 items', function () {",
                  "  pm.expect(body).to.have.property('data').that.is.an('array');",
                  "  pm.expect(body.data.length).to.be.at.most(5);",
                  "});",
                  "",
                  "pm.test('every user has the schema minimum fields', function () {",
                  "  body.data.forEach(function (u) {",
                  "    pm.expect(u).to.have.all.keys('id', 'email', 'name', 'role', 'createdAt', 'metadata');",
                  "  });",
                  "});",
                  "",
                  "pm.test('pagination present', function () {",
                  "  pm.expect(body.pagination).to.have.all.keys('page', 'perPage', 'total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /users/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/00000000-0000-0000-0000-000000000002",
              "host": ["{{baseUrl}}"],
              "path": ["users", "00000000-0000-0000-0000-000000000002"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('returns the requested id', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql('00000000-0000-0000-0000-000000000002');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /users",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"name\": \"{{$randomFullName}}\",\n  \"password\": \"S3cretPass!{{$randomInt}}\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Location header points to the new resource', function () {",
                  "  const location = pm.response.headers.get('Location');",
                  "  pm.expect(location).to.match(/\\/users\\/[a-f0-9-]{36}$/);",
                  "});",
                  "",
                  "pm.test('captures userId in the environment', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.environment.set('userId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /users/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('empty body', function () {",
                  "  pm.expect(pm.response.text() || '').to.have.length(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "GET /orders?status=paid",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders?status=paid",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [{ "key": "status", "value": "paid" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('all returned orders have status paid', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  body.data.forEach(function (o) {",
                  "    pm.expect(o.status).to.eql('paid');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /orders",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"00000000-0000-0000-0000-000000000002\",\n  \"currency\": \"BRL\",\n  \"items\": [\n    { \"sku\": \"SKU-100\", \"description\": \"Test item A\", \"quantity\": 2, \"priceCents\": 1500 },\n    { \"sku\": \"SKU-101\", \"description\": \"Test item B\", \"quantity\": 1, \"priceCents\": 4990 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('totalCents matches the sum of items', function () {",
                  "  const expected = 2 * 1500 + 1 * 4990;",
                  "  pm.expect(body.totalCents).to.eql(expected);",
                  "});",
                  "",
                  "pm.test('captures orderId', function () {",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.environment.set('orderId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /orders/:id/status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"paid\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('order status was updated to paid', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('paid');",
                  "  pm.expect(body.id).to.eql(pm.environment.get('orderId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
