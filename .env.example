NODE_ENV=development
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=3000
API_BASE_URL=http://localhost:3000

# For Postgres in production, use: postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL=file:./prisma/dev.db

JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_EXPIRES_IN=1h

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Comma-separated list of allowed origins. "*" allows everything (dev only).
CORS_ORIGINS=*

# true when behind a load balancer or ingress that sets X-Forwarded-For
TRUST_PROXY=false

SHUTDOWN_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
BODY_LIMIT_BYTES=1048576

METRICS_ENABLED=true
METRICS_PATH=/metrics

PACT_BROKER_URL=http://localhost:9292
PACT_BROKER_TOKEN=

WIREMOCK_URL=http://localhost:8089

GIT_SHA=local
GIT_BRANCH=local
