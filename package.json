{
  "name": "api-testing-framework",
  "version": "0.1.0",
  "description": "REST and GraphQL API testing framework with contract testing, schema validation, mock servers, security and performance",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "api:dev": "tsx watch src/api/server.ts",
    "api:start": "node dist/api/server.js",
    "api:build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functional": "vitest run tests/functional",
    "test:graphql": "vitest run tests/graphql",
    "test:schema": "vitest run tests/schema",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:integration:postgres": "prisma generate --schema prisma/schema.postgres.prisma && vitest run --config vitest.postgres.config.ts && prisma generate",
    "test:pact:consumer": "vitest run tests/contract/consumer",
    "test:pact:provider": "vitest run tests/contract/provider",
    "test:perf:smoke": "k6 run tests/performance/smoke.js",
    "test:perf:load": "k6 run tests/performance/load.js",
    "test:postman": "newman run postman/collection.json -e postman/environment.json",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:ci": "stryker run --reporters dots,clear-text",
    "pact:publish": "pact-broker publish ./pacts --consumer-app-version=${GIT_SHA:-local} --branch=${GIT_BRANCH:-local} --broker-base-url=${PACT_BROKER_URL} --broker-token=${PACT_BROKER_TOKEN}",
    "pact:can-i-deploy": "pact-broker can-i-deploy --pacticipant FrontendApp --version=${GIT_SHA} --to-environment production --broker-base-url=${PACT_BROKER_URL}",
    "mocks:wiremock": "docker run --rm -p 8089:8080 -v $PWD/mocks/wiremock:/home/wiremock wiremock/wiremock:3.9.1",
    "prepare": "husky || true",
    "commit": "cz",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "dependencies": {
    "@fastify/compress": "8.0.1",
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/under-pressure": "9.0.3",
    "@fastify/jwt": "9.0.1",
    "@fastify/rate-limit": "10.1.1",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.1.0",
    "@prisma/client": "5.22.0",
    "fastify": "5.8.5",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "4.0.2",
    "graphql": "16.14.2",
    "mercurius": "16.9.0",
    "pino": "9.5.0",
    "prom-client": "15.1.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@commitlint/cli": "19.6.0",
    "@commitlint/config-conventional": "19.6.0",
    "@faker-js/faker": "9.2.0",
    "@pact-foundation/pact": "13.2.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.1",
    "@stryker-mutator/core": "8.7.1",
    "@stryker-mutator/typescript-checker": "8.7.1",
    "@stryker-mutator/vitest-runner": "8.7.1",
    "@types/js-yaml": "4.0.9",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.9.1",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "@vitest/coverage-v8": "2.1.5",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axios": "1.7.7",
    "commitizen": "4.3.1",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "16.4.5",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vitest": "0.5.4",
    "graphql-request": "7.1.2",
    "husky": "9.1.7",
    "js-yaml": "4.1.0",
    "jsonwebtoken": "9.0.2",
    "lint-staged": "15.2.10",
    "msw": "2.6.6",
    "newman": "6.2.1",
    "openapi-schema-validator": "12.1.3",
    "pino-pretty": "11.3.0",
    "prettier": "3.3.3",
    "prisma": "5.22.0",
    "semantic-release": "24.2.0",
    "supertest": "7.0.0",
    "testcontainers": "10.13.2",
    "@testcontainers/postgresql": "10.13.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
